# Copy this file to .env and fill in the values (`make init` does it for development).
# .env is git-ignored: never commit secrets.
# Both docker-compose.yml (production) and dev/docker-compose.yml read this file.
# Every variable is described in docs/configuration.md.

# --- Project ---
PROJECT_NAME=nexus
APP_NAME=nexusHome
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Production deployment (docker-compose.yml) ---
# Image to run (Docker Hub repository) and its tag: stable, latest or a version such as 1.2.0.
DOCKER_IMAGE=cibrandocampo/nexus-home
APP_TAG=stable
# Host port the app is published on (the reverse proxy points here).
APP_PORT=8000
# Folder for persistent data; the database lives in $DATA_PATH/postgres.
DATA_PATH=./data

# --- Database (PostgreSQL) ---
POSTGRES_USER=app
# Letters and digits only: it is placed inside the database URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# --- Sessions ---
# Long random string; production refuses the default. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# A just-rotated refresh token sent again within this many seconds (two tabs) is refused
# without ending the session.
REFRESH_REUSE_GRACE_SECONDS=10
# bcrypt cost factor for password hashes.
BCRYPT_ROUNDS=12
# Keep true behind HTTPS. Set false only when the app is served over plain HTTP.
COOKIE_SECURE=true

# --- Email (SMTP) ---
# Public address of the app, used in links inside emails.
SITE_URL=https://app.example.com
EMAIL_FROM=nexusHome <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# none | starttls | ssl
SMTP_TLS=starttls
SMTP_TIMEOUT_SECONDS=10
# smtp, or memory (emails are kept in memory and never sent: tests only)
EMAIL_BACKEND=smtp

# --- Login ---
# true: anyone can create an account with their email; it starts without permissions.
ALLOW_SELF_SIGNUP=false
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
UNVERIFIED_SIGNUP_DAYS=7
BLOCK_DISPOSABLE_EMAIL=true
# Comma-separated domains to add to / remove from the disposable list.
DISPOSABLE_EMAIL_EXTRA_DOMAINS=
DISPOSABLE_EMAIL_ALLOW_DOMAINS=

# --- Rate limits and proxies ---
RATE_LIMIT_ENABLED=true
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=

# --- First administrator (created at start-up if no admin exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# --- Device simulators (development stack only: dev/docker-compose.yml) ---
# Access tokens of the two simulated garage boards, and how many simulated seconds pass per real one.
SIM_GARAGE_A_TOKEN=sim-garage-a-token
SIM_GARAGE_B_TOKEN=sim-garage-b-token
SIM_SPEED=1
